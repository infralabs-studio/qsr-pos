# --- Django ---
# Generated automatically by scripts/setup.sh when left as change-me
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vite dev server origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
# POSTGRES_HOST is localhost for runs on your machine; docker-compose overrides it to "db"
POSTGRES_DB=qsr_pos
POSTGRES_USER=qsr
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- M-PESA Daraja 
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# --- POS behaviour ---
# True = menu prices already include VAT. Open product decision (tax rules); assumption for now.
POS_PRICES_TAX_INCLUSIVE=True

.env.example: add a section:

bash
# --- Cloud sync (Outbox drain) ---
# Blank CLOUD_SYNC_URL disables sync. For the local mock cloud (compose profile cloud-mock):
#   CLOUD_SYNC_URL=http://cloud:8000/cloud/ingest/
CLOUD_SYNC_URL=
CLOUD_API_KEY=pfboXCEC68IPZpOWMB74Qxv_aLbX2khHeaME5JwNe9w
# Turns on the mock receiver endpoint. Only the mock cloud service sets this to true.
CLOUD_MOCK_ENABLED=False
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_SECONDS=5
OUTBOX_LEASE_SECONDS=60
OUTBOX_BACKOFF_BASE_SECONDS=2
OUTBOX_BACKOFF_CAP_SECONDS=60

# --- Reconciliation (placeholders until Glory confirms) ---
# How far either side of a manual payment's time a near-match record may fall.
RECONCILIATION_WINDOW_MINUTES=30
# How long an unmatched manual payment stays "pending" before it goes to manager review.
RECONCILIATION_GRACE_HOURS=24