# --- Django ---
# Generated automatically by scripts/setup.sh when left as change-me
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vite dev server origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
# POSTGRES_HOST is localhost for runs on your machine; docker-compose overrides it to "db"
POSTGRES_DB=qsr_pos
POSTGRES_USER=qsr
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- M-PESA Daraja 
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=